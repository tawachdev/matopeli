---
import '../styles/app.css';
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<title>Matopeli — Snake II in Rust + WebAssembly</title>
</head>
<body class="min-h-screen font-nokia text-slate-100">
<main class="mx-auto w-full max-w-[400px] px-3 py-5">
  <header class="mb-3.5 text-center">
    <h1 class="font-lcd text-[28px] tracking-[5px]">MATOPELI</h1>
    <p class="mt-1.5 text-xs text-slate-400">Rust engine · WebAssembly · works fully offline</p>
  </header>

  <div class="phone-body bg-gradient-to-b from-nokiablue-face to-nokiablue-dark px-5 pb-6 pt-4">
    <div class="mx-auto mb-1.5 h-[7px] w-14 rounded bg-[#141a26] shadow-inner"></div>
    <div class="mb-2 text-center text-[13px] font-bold tracking-[4px] text-slate-100/90">SNAKE II</div>

    <div class="mb-2 flex items-end justify-between text-white">
      <div><label class="block text-[10px] tracking-[2px] text-slate-300">Score</label><b id="score" class="font-lcd text-[22px]">0</b></div>
      <div class="dots flex gap-[5px] pb-1.5" id="dots" title="level progress"></div>
      <div class="text-right"><label class="block text-[10px] tracking-[2px] text-slate-300">Best</label><b id="best" class="font-lcd text-[22px]">0</b></div>
    </div>

    <div class="rounded-[14px] bg-[#c3c8d2] p-2.5 shadow-[inset_0_2px_5px_rgba(0,0,0,0.4)]">
      <div class="relative overflow-hidden rounded-md border-[3px] border-[#5b616c]">
        <canvas id="lcd" width="280" height="160" class="block w-full bg-lcd-bg"></canvas>
        <div class="scanlines pointer-events-none absolute inset-0"></div>
        <div class="banner absolute inset-0 flex-col items-center justify-center gap-2 bg-lcd-bg/90 p-2.5 text-center font-lcd text-lcd-ink" id="banner">
          <b id="bannerTitle" class="text-[22px] tracking-[2px]">Snake II</b>
          <span id="bannerSub" class="text-xs">Key 1-9 picks a level, then Start</span>
          <div class="levels flex flex-wrap justify-center gap-1.5" id="levels"></div>
        </div>
      </div>
    </div>
    <div class="mx-0.5 my-2 flex items-center justify-between">
      <span id="level" class="text-[11px] text-slate-300">Level 1/9</span>
      <button id="btnSound" class="bg-transparent text-[11px] text-slate-300 underline">Sound on</button>
    </div>

    <div class="mb-2.5 grid grid-cols-[1fr_1.3fr_1fr] items-center gap-2">
      <button id="softL" class="btn-key text-[13px]">Start</button>
      <button id="navi" class="navi-ring rounded-full bg-gradient-to-b from-slate-100 to-slate-300 p-2" aria-label="ok"><span class="block h-[26px] rounded-full bg-[radial-gradient(circle_at_50%_35%,#4d6a9e,#2c4470)] shadow-[inset_0_2px_4px_rgba(0,0,0,0.5)]"></span></button>
      <button id="keyC" class="btn-key text-[13px]">C</button>
    </div>
    <div class="grid grid-cols-3 gap-2" id="keypad">
      <button data-k="1" class="btn-key flex-col leading-tight"><b class="text-[17px]">1</b><small class="text-[9px] tracking-widest text-slate-500">.,?</small></button>
      <button data-k="2" class="btn-key flex-col leading-tight"><b class="text-[17px]">2</b><small class="text-[9px] tracking-widest text-slate-500">abc ↑</small></button>
      <button data-k="3" class="btn-key flex-col leading-tight"><b class="text-[17px]">3</b><small class="text-[9px] tracking-widest text-slate-500">def</small></button>
      <button data-k="4" class="btn-key flex-col leading-tight"><b class="text-[17px]">4</b><small class="text-[9px] tracking-widest text-slate-500">ghi ←</small></button>
      <button data-k="5" class="btn-key flex-col leading-tight"><b class="text-[17px]">5</b><small class="text-[9px] tracking-widest text-slate-500">jkl</small></button>
      <button data-k="6" class="btn-key flex-col leading-tight"><b class="text-[17px]">6</b><small class="text-[9px] tracking-widest text-slate-500">mno →</small></button>
      <button data-k="7" class="btn-key flex-col leading-tight"><b class="text-[17px]">7</b><small class="text-[9px] tracking-widest text-slate-500">pqrs</small></button>
      <button data-k="8" class="btn-key flex-col leading-tight"><b class="text-[17px]">8</b><small class="text-[9px] tracking-widest text-slate-500">tuv ↓</small></button>
      <button data-k="9" class="btn-key flex-col leading-tight"><b class="text-[17px]">9</b><small class="text-[9px] tracking-widest text-slate-500">wxyz</small></button>
      <button data-k="*" class="btn-key flex-col leading-tight"><b class="text-[17px]">*</b><small class="text-[9px] tracking-widest text-slate-500">sym</small></button>
      <button data-k="0" class="btn-key flex-col leading-tight"><b class="text-[17px]">0</b><small class="text-[9px] tracking-widest text-slate-500">+</small></button>
      <button data-k="#" class="btn-key flex-col leading-tight"><b class="text-[17px]">#</b><small class="text-[9px] tracking-widest text-slate-500">a/A</small></button>
    </div>
    <div class="mx-auto mb-0 mt-3 h-2 w-2 rounded-full bg-[#141a26] shadow-inner"></div>
  </div>

  <section class="mt-4 grid grid-cols-2 gap-2 font-nokia text-xs text-slate-400">
    <div><b class="text-slate-200">2 4 6 8</b> steer — like the real thing</div>
    <div><b class="text-slate-200">1–9</b> pick level · <b class="text-slate-200">C</b> pause</div>
    <div><b class="text-slate-200">Arrows / WASD</b> work too · swipe the screen</div>
    <div>Eat <b class="text-accent">5</b> to clear a level · grab the bug fast</div>
  </section>
  <footer class="mt-2.5 text-center text-[11px] text-slate-500">Tribute to the Nokia 3310 · game logic in Rust</footer>
</main>
<script>
  import '../scripts/snake.ts';
</script>
</body>
</html>
