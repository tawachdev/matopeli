---
import '../styles/app.css';
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
<meta name="theme-color" content="#2a3a63" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Matopeli" />
<link rel="manifest" href="manifest.webmanifest" />
<link rel="apple-touch-icon" href="apple-touch-icon.png" />
<title>Matopeli — Snake II in Rust + WebAssembly</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2016%2016'%3E%3Crect%20width='16'%20height='16'%20rx='3'%20fill='%239aa763'/%3E%3Crect%20x='3'%20y='3'%20width='4'%20height='4'%20fill='%23232a12'/%3E%3Crect%20x='7'%20y='7'%20width='4'%20height='4'%20fill='%23232a12'/%3E%3Crect%20x='3'%20y='11'%20width='6'%20height='2'%20fill='%23232a12'/%3E%3C/svg%3E" />
</head>
<body class="font-nokia">
<main class="phone" aria-label="Nokia 3310">
  <div class="earpiece" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  <div class="brand" aria-hidden="true">NOKIA</div>

  <div class="lens">
    <div class="lcd-window relative overflow-hidden">
      <canvas id="lcd" width="280" height="190" class="block w-full bg-lcd-bg" role="img" aria-label="Snake game board"></canvas>
      <div class="scanlines pointer-events-none absolute inset-0"></div>
      <div class="banner absolute inset-0 flex-col items-center justify-center gap-2 bg-lcd-bg/90 p-2.5 text-center font-lcd text-lcd-ink" id="banner">
        <b id="bannerTitle" class="text-[22px] tracking-[2px]">Snake II</b>
        <span id="bannerSub" class="text-xs">Pick a level, then Start</span>
        <div class="levels flex flex-wrap justify-center gap-1.5" id="levels"></div>
        <input id="levelInput" type="number" min="1" max="99" inputmode="numeric" placeholder="or type level" class="level-input" />
        <ol id="hall" class="hall"></ol>
      </div>
      <div id="osRoot" class="hidden">
        <div id="osScreen"></div>
      </div>
      <div id="bootScreen" class="hidden">
        <b class="boot-logo">NOKIA</b>
        <span class="boot-sub">matopeli OS</span>
      </div>
    </div>
  </div>

  <div class="controls">
    <button id="keyC" class="key-c" aria-label="C (back)">C</button>
    <button id="navi" class="navi" aria-label="Navi key (select)"><span></span></button>
    <div class="rocker" role="group" aria-label="Scroll keys">
      <button id="keyUp" class="rocker-key" aria-label="Scroll up">
        <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1.5 6.5 6 2l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button id="keyDown" class="rocker-key" aria-label="Scroll down">
        <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>

  <div class="keypad" id="keypad">
    <button data-k="1" class="key"><b>1</b><small>.,?</small></button>
    <button data-k="2" class="key"><b>2</b><small>abc</small></button>
    <button data-k="3" class="key"><b>3</b><small>def</small></button>
    <button data-k="4" class="key"><b>4</b><small>ghi</small></button>
    <button data-k="5" class="key"><b>5</b><small>jkl</small></button>
    <button data-k="6" class="key"><b>6</b><small>mno</small></button>
    <button data-k="7" class="key"><b>7</b><small>pqrs</small></button>
    <button data-k="8" class="key"><b>8</b><small>tuv</small></button>
    <button data-k="9" class="key"><b>9</b><small>wxyz</small></button>
    <button data-k="*" class="key"><b>*</b><small>+</small></button>
    <button data-k="0" class="key"><b>0</b><small>&nbsp;</small></button>
    <button data-k="#" class="key"><b>#</b><small>menu</small></button>
  </div>
  <div class="mic" aria-hidden="true"></div>

  <div class="sr-only" role="status" aria-live="polite">
    Score <b id="score">0</b>, best <b id="best">0</b>, <span id="level">Level 1</span>
    <div id="progress"><span id="progressBar"></span></div>
  </div>
</main>
<div id="settings" class="settings hidden" role="dialog" aria-modal="true" aria-label="settings">
  <div class="lcd-menu">
    <div class="lcd-title" id="menuTitle">Settings</div>
    <ul class="lcd-list" id="menuList"></ul>
    <div class="lcd-soft"><span>Select</span><button id="menuBack" class="lcd-back" type="button">Back</button></div>
  </div>
</div>
<script>
  import '../scripts/snake.ts';
  import '../os/boot-main.ts';
</script>
</body>
</html>
